{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(.venv/bin/python *.py)",
      "Bash(.venv/bin/python *.py *)",
      "Bash(./.venv/bin/python *.py)",
      "Bash(./.venv/bin/python *.py *)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(./.venv/bin/python -m pytest *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(./.venv/bin/pytest *)",
      "Bash(pytest *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(sudo)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(.env)",
      "Read(**/.env)"
    ]
  }
}
